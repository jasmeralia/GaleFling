# GaleFling functional test configuration — SKELETON
#
# Copy to tests/functional/.env and fill in real values:
#     cp tests/functional/.env.example tests/functional/.env
#
# tests/functional/.env is gitignored. This file is NOT — never put real
# credentials here.
#
# Any platform whose credentials are left blank is skipped (that is the one
# legitimate skip). Every other failure is a real defect and must fail the run.
#
# See docs/testing/FUNCTIONAL_TESTING.md and docs/testing/WEBVIEW_TEST_PLAN.md.

# ── Test harness behaviour ───────────────────────────────────────────
# Set to 1 to make functional tests FAIL instead of skip when something goes
# wrong (login failure, missing selector, renderer crash). Absent credentials
# still skip. Leave unset for the legacy lenient behaviour.
GALEFLING_STRICT_FUNCTIONAL=1

# Twitter (OAuth 1.0a)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Bluesky
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Instagram (Graph API — graph.instagram.com)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Meta Threads (Graph API — graph.threads.net)
META_THREADS_ACCESS_TOKEN=
META_THREADS_USER_ID=

# Meta Facebook Page (Graph API — graph.facebook.com)
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=

# Meta AWS S3 media staging (shared by Instagram and Threads for image/video/carousel posts)
# The bucket must be public-read with a 7-day object lifecycle policy.
# See infrastructure/galefling-media-staging.yaml for the CloudFormation stack.
META_AWS_ACCESS_KEY_ID=
META_AWS_SECRET_ACCESS_KEY=
META_AWS_REGION=us-west-2
META_AWS_BUCKET=

# WebView platforms — GaleFling data directory
# Export via Settings > Advanced > Export Test Config, or set manually.
# The app resolves this per-platform (src/utils/helpers.py:get_app_data_dir):
#   Linux (native):  /home/you/.config/GaleFling
#   Windows:         C:\Users\you\AppData\Roaming\GaleFling
#   WSL → Windows:   /mnt/c/Users/you/AppData/Roaming/GaleFling
# Use the path for the host the tests actually run on. The Linux and Windows
# profiles are separate; logging in on one does not authenticate the other.
GALEFLING_DATA_DIR=

# OnlyFans (WebView)
# If the session cookie has expired the tests will log in automatically.
# ONLYFANS_TOTP_SECRET is the base32-encoded TOTP secret from your authenticator
# app (required only if 2FA is enabled on the account).
ONLYFANS_EMAIL=
ONLYFANS_PASSWORD=
ONLYFANS_TOTP_SECRET=

# Fansly (WebView)
# If the session cookie has expired the tests will log in automatically.
FANSLY_EMAIL=
FANSLY_PASSWORD=

# FetLife (WebView)
# If the session cookie has expired the tests will log in automatically.
FETLIFE_EMAIL=
FETLIFE_PASSWORD=

# Threads (WebView)
# If the session cookie has expired the tests will log in automatically
# via threads.net/login using the Instagram/Meta username and password below.
THREADS_USERNAME=
THREADS_PASSWORD=

# Snapchat (WebView)
# If the session cookie has expired the tests will log in automatically
# via accounts.snapchat.com using the username/email and password below.
SNAPCHAT_USERNAME=
SNAPCHAT_PASSWORD=
