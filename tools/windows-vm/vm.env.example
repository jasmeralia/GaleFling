# Copy this file to vm.env and adjust local paths. vm.env is gitignored.

# Libvirt identity and resources.
VM_NAME=galefling-win11
VM_COMPUTER_NAME=GALEFLING-WIN11
VM_USER=morgan
VM_FULL_NAME=Morgan
VM_TIME_ZONE='Pacific Standard Time'
VM_MEMORY_MIB=16384
VM_VCPUS=4
VM_DISK_GIB=120
LIBVIRT_URI=qemu:///system
LIBVIRT_NETWORK=default
LIBVIRT_QEMU_USER=libvirt-qemu
BASELINE_SNAPSHOT=clean-loggedout

# Keep all large artifacts, generated answer files, and secrets outside Git.
DATA_DIR="$HOME/.local/share/galefling/windows-vm"
WINDOWS_ISO="$DATA_DIR/windows-11.iso"
VIRTIO_ISO="$DATA_DIR/virtio-win-0.1.285.iso"
PYTHON_INSTALLER="$DATA_DIR/python-3.12.10-amd64.exe"
WINFSP_INSTALLER="$DATA_DIR/winfsp-2.1.25156.msi"
PRODUCT_KEY_FILE="$DATA_DIR/windows-product-key.txt"
VM_PASSWORD_FILE="$DATA_DIR/vm-password.txt"
DISK_IMAGE="/var/lib/libvirt/images/$VM_NAME.qcow2"

# Keep the actual keypair in ~/.ssh; only its paths belong in vm.env.
SSH_PRIVATE_KEY="$HOME/.ssh/id_ed25519"
SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519.pub"

# Optional integrity checks for the pinned support installers.
VIRTIO_SHA256=e14cf2b94492c3e925f0070ba7fdfedeb2048c91eea9c5a5afb30232a3976331
PYTHON_SHA256=67b5635e80ea51072b87941312d00ec8927c4db9ba18938f7ad2d27b328b95fb
WINFSP_SHA256=073a70e00f77423e34bed98b86e600def93393ba5822204fac57a29324db9f7a
